// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js" // التسمية القياسية
  // output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // لا نضع url هنا أبداً في Prisma 7
}

model User {
  id                Int      @id @default(autoincrement())
  name              String
  email             String   @unique
  image             String?
  preferredCurrency String   @default("SYP")
  provider          String? // "google" أو "credentials"
  providerId        String? // معرف المستخدم من مزود الهوية (مثل Google)
  passwordHash      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  wallets      Wallet[]
  transactions Transaction[]
  categories   Category[]    @relation("UserCategories")
  // budgets      Budget[]
}

model Wallet {
  id        Int      @id @default(autoincrement())
  name      String
  balance   Decimal  @default(0)
  userId    Int
  currency  String   @default("SYP")
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([userId])
}

enum TxType {
  INCOME
  EXPENSE
  TRANSFER
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  icon      String?
  userId    Int?
  user      User?    @relation("UserCategories", fields: [userId], references: [id])
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  // budgets      Budget[]

  @@unique([userId, name])
}

model Transaction {
  id          Int      @id @default(autoincrement())
  type        TxType
  amount      Decimal
  occurredAt  DateTime
  description String?
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id])

  walletId Int
  wallet   Wallet @relation(fields: [walletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, occurredAt])
  @@index([categoryId])
  @@index([walletId])
}

model AiAnalysisCache {
  id        String   @id @default(cuid())
  userId    String   @unique
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("ai_analysis_cache")
}
