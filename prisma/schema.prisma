// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js" // التسمية القياسية
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // لا نضع url هنا أبداً في Prisma 7
}

model User {
  id           Int     @id @default(autoincrement())
  name         String
  email        String  @unique
  passwordHash String? // nullable لأن Google users ما عندهم password

  image      String? // صورة المستخدم من Google
  provider   String  @default("credentials") // "credentials" | "google"
  providerId String? // Google user ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets Wallet[]
  // transactions  Transaction[]
  // categories    Category[] @relation("UserCategories")
  // budgets       Budget[]

  @@unique([provider, providerId]) // to ensure no duplicate Google users
}

model Wallet {
  id        Int      @id @default(autoincrement())
  name      String
  balance   Decimal  @default(0)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // transactions Transaction[]

  @@index([userId])
}
